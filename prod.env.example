# Server settings for docker-compose.prod.yml — copy to prod.env on the server and fill in:
#   cp prod.env.example prod.env && chmod 600 prod.env
# prod.env is not tracked by git (it holds secrets). scripts/prod.sh passes it to docker compose.

# Release to run (upgrade: change it, then scripts/prod.sh pull && scripts/prod.sh up -d)
APP_VERSION=0.1.82

# With extension apps: the backend image the installation repository built (base + its apps;
# Installed Apps → Build List, EXTENSIONS.md). Leave it out to run the base release's image.
# The image is private: log in once with  docker login ghcr.io  (a token that may read packages).
#BACKEND_IMAGE=ghcr.io/<owner>/<installation-repository>/backend:<version>

# Extension apps built by the installation's own builder (App Build Setup: Builds By = Local
# Builder; docs/operations.md): start the builder service with the profile apps. APPS_TOKEN: read
# access to private app repositories on GitHub (empty: public ones only).
#COMPOSE_PROFILES=apps
#APPS_TOKEN=

# Session signing key; without it every restart logs all users out. Generate once:
#   openssl rand -hex 32
JWT_SECRET=

# The first user (SUPER in every company) is made on the login page with this setup token.
# Empty: the backend makes a random one and writes it to its log while there is no user yet:
#   scripts/prod.sh logs backend | grep "setup token"
SETUP_TOKEN=

# A session without requests ends after this time (e.g. 30m, 8h; empty: 2h; 0: only the 24 hours
# after the login). Sessions always end 24 hours after the login.
SESSION_IDLE_TIMEOUT=

# The mail server of SMTP Setup is never this server itself (loopback) or a link-local address
# (the cloud metadata service). true: not a private address (10.x, 172.16-31.x, 192.168.x) either
# — set it when the mail server is outside your network
SMTP_BLOCK_PRIVATE=

# Key that encrypts secrets stored in the database (the SMTP password). Set it once:
#   openssl rand -hex 32
# Empty: a key derived from JWT_SECRET, which then cannot be changed without entering the SMTP
# password again. Setting it on an installation that ran without it is safe: the next start
# encrypts the stored secrets with it (the JWT_SECRET key still reads them).
OPENERP_ENCRYPTION_KEY=
# The key before OPENERP_ENCRYPTION_KEY, only while changing it: the next start encrypts the
# stored secrets with the new key; then empty it (docs/operations.md, Rotating the secrets).
OPENERP_ENCRYPTION_KEY_OLD=

# Postgres password (required): openssl rand -hex 24. Only applied when the database volume is
# created — on an existing installation change it in the database first (docs/operations.md,
# Changing the database password), then here. The server works as the role goeasyerp with it;
# the superuser openerp has no password (docs: Database roles). Never openerp: everyone knows it.
POSTGRES_PASSWORD=

# The most database connections the backend opens at once (empty: 40). PostgreSQL allows 100
# (max_connections); the rest stays free for the app builder, backups and psql.
DB_MAX_CONNS=

# The app builder's database password (its role may change its build tables only): openssl rand -hex 24
BUILDER_DB_PASSWORD=

# The company the server enters at startup (migrations and the table sync run for every company;
# users pick their company at login). Optional: empty enters the first company by name, and a new,
# empty database starts with the company "main". A name that does not exist enters the first company.
COMPANY_NAME=

# Where the backend (8080) and frontend (3000) ports are published. 127.0.0.1 = only on this
# host (a tunnel or proxy on the same machine); 0.0.0.0 = the whole network (only if a proxy on
# another machine must reach them). Users normally come through nginx on 80/443.
PUBLISH_HOST=127.0.0.1

# NAV report proxy for the NAV Report Runner codeunit (Job Queue). Empty: http://localhost:5009,
# which inside the backend container is the container itself — set the proxy's real address.
NAV_PROXY_URL=

# The proxies whose X-Forwarded-For the backend believes (the client's address for the login
# rate limit): addresses or CIDR ranges, comma separated. Empty: loopback and the private ranges
# (the Docker network's nginx). From any other address the header is ignored.
TRUSTED_PROXIES=

# Themes installed from GitHub (user menu > Appearance). GITHUB_TOKEN is optional: without it
# GitHub allows 60 API requests per hour (each install needs 2). A fine-grained token with no
# permissions (public repositories only) is enough. THEME_ALLOWED_OWNERS limits installs to these
# GitHub owners, comma separated (e.g. basecamp,someone); empty allows any owner.
GITHUB_TOKEN=
THEME_ALLOWED_OWNERS=
